# =============================================================
# LECTURA DE ARCHIVOS (TXT, EXCEL, JSON)
# =============================================================

def leer_txt(ruta):
    """Lee números de un archivo .txt (separados por coma, espacio o línea)."""
    with open(ruta, "r", encoding="utf-8") as f:
        contenido = f.read()
    tokens = contenido.replace(",", " ").replace("\n", " ").split()
    if not tokens:
        raise ValueError(f"El archivo '{ruta}' está vacío.")
    numeros = []
    for tok in tokens:
        tok = tok.strip()
        if not tok:
            continue
        try:
            num = float(tok)
            numeros.append(int(num) if num == int(num) else num)
        except ValueError:
            raise ValueError(f"Valor no numérico en TXT: '{tok}'")
    return numeros


def leer_excel(ruta):
    """
    Lee números de un archivo Excel (.xlsx).
    Recorre TODAS las hojas y TODAS las celdas con valores numéricos.
    """
    if not EXCEL_DISPONIBLE:
        raise ImportError("Instala openpyxl:  pip install openpyxl")
    wb = openpyxl.load_workbook(ruta, data_only=True)
    numeros = []
    for nombre_hoja in wb.sheetnames:
        hoja = wb[nombre_hoja]
        for fila in hoja.iter_rows(values_only=True):
            for celda in fila:
                if isinstance(celda, (int, float)) and celda is not None:
                    numeros.append(int(celda) if celda == int(celda) else celda)
    if not numeros:
        raise ValueError(f"No se encontraron números en '{ruta}'.")
    return numeros


def leer_json(ruta):
    """
    Lee números de un archivo .json.
    Soporta dos formatos:
      - Lista simple:        [10, 5, 8, 3]
      - Con clave numeros:   {"numeros": [10, 5, 8, 3]}
      - Cualquier lista dentro del JSON que contenga números
    """
    with open(ruta, "r", encoding="utf-8") as f:
        datos = json.load(f)

    def extraer_numeros(obj):
        encontrados = []
        if isinstance(obj, list):
            for item in obj:
                if isinstance(item, (int, float)):
                    encontrados.append(int(item) if item == int(item) else item)
                elif isinstance(item, (list, dict)):
                    encontrados.extend(extraer_numeros(item))
        elif isinstance(obj, dict):
            for val in obj.values():
                encontrados.extend(extraer_numeros(val))
        return encontrados

    numeros = extraer_numeros(datos)
    if not numeros:
        raise ValueError(f"No se encontraron números en '{ruta}'.")
    return numeros


def leer_archivo(ruta):
    """Detecta el tipo de archivo por extensión y llama al lector correcto."""
    ext = os.path.splitext(ruta)[1].lower()
    if ext == ".txt":
        return leer_txt(ruta), "TXT"
    elif ext in (".xlsx", ".xls"):
        return leer_excel(ruta), "Excel"
    elif ext == ".json":
        return leer_json(ruta), "JSON"
    else:
        raise ValueError(f"Formato no soportado: '{ext}'. Usa .txt, .xlsx o .json")


