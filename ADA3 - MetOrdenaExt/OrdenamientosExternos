        if opcion == "0":
            print("\n  ¡Hasta luego!\n")
            break
        elif opcion == "1":
            ejecutar_metodo("Intercalacion")
            input("\n  Presiona ENTER para volver al menú...")
        elif opcion == "2":
            ejecutar_metodo("Mezcla Directa")
            input("\n  Presiona ENTER para volver al menú...")
        elif opcion == "3":
            k = pedir_k()
            ejecutar_metodo("Mezcla Equilibrada", k=k)
            input("\n  Presiona ENTER para volver al menú...")
        else:
            input("\n  [!] Opción inválida. Presiona ENTER para continuar...")


