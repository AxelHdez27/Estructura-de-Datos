def abrir_explorador(numero):
    """
    Abre el explorador de archivos nativo del sistema operativo
    para que el usuario seleccione un archivo visualmente.
    Filtra por TXT, Excel y JSON.
    """
    if not TKINTER_DISPONIBLE:
        return None

    root = tk.Tk()
    root.withdraw()           # Oculta la ventana principal de tkinter
    root.attributes('-topmost', True)  # Aparece encima de otras ventanas

    ruta = filedialog.askopenfilename(
        title=f"Selecciona el Archivo {numero}",
        filetypes=[
            ("Todos los soportados", "*.txt *.xlsx *.xls *.json"),
            ("Archivos de texto",    "*.txt"),
            ("Archivos Excel",       "*.xlsx *.xls"),
            ("Archivos JSON",        "*.json"),
            ("Todos los archivos",   "*.*"),
        ]
    )
    root.destroy()
    return ruta if ruta else None


def abrir_explorador_guardar():
    """Abre el explorador para elegir dónde guardar el archivo de salida."""
    if not TKINTER_DISPONIBLE:
        return None

    root = tk.Tk()
    root.withdraw()
    root.attributes('-topmost', True)

    ruta = filedialog.asksaveasfilename(
        title="Guardar archivo ordenado como...",
        defaultextension=".txt",
        filetypes=[("Archivo de texto", "*.txt")]
    )
    root.destroy()
    return ruta if ruta else None


# =============================================================
# ALGORITMOS DE ORDENAMIENTO
# =============================================================

def intercalar(izq, der):
    resultado = []
    i = j = 0
    while i < len(izq) and j < len(der):
        if izq[i] <= der[j]:
            resultado.append(izq[i]); i += 1
        else:
            resultado.append(der[j]); j += 1
    resultado.extend(izq[i:])
    resultado.extend(der[j:])
    return resultado


def ordenar_intercalacion(lista):
    """Intercalación — Merge Sort recursivo. O(n log n)."""
    if len(lista) <= 1:
        return lista
    medio = len(lista) // 2
    return intercalar(
        ordenar_intercalacion(lista[:medio]),
        ordenar_intercalacion(lista[medio:])
    )


def mezclar_runs(lista, inicio, medio, fin):
    izq = lista[inicio:medio]
    der = lista[medio:fin]
    i = j = 0; k = inicio
    while i < len(izq) and j < len(der):
        if izq[i] <= der[j]:
            lista[k] = izq[i]; i += 1
        else:
            lista[k] = der[j]; j += 1
        k += 1
    while i < len(izq): lista[k] = izq[i]; i += 1; k += 1
    while j < len(der):  lista[k] = der[j]; j += 1; k += 1


def ordenar_mezcla_directa(lista):
    """Mezcla Directa — iterativa, runs 1→2→4→8… O(n log n)."""
    n = len(lista); tam = 1
    while tam < n:
        for inicio in range(0, n, tam * 2):
            medio = min(inicio + tam, n)
            fin   = min(inicio + tam * 2, n)
            if medio < fin:
                mezclar_runs(lista, inicio, medio, fin)
        tam *= 2
    return lista


def ordenar_mezcla_equilibrada(lista, k=2):
    """Mezcla Equilibrada — k cintas ajustables. O(n log_k n)."""
    if len(lista) <= 1:
        return lista[:]
    runs = [[x] for x in lista]
    while len(runs) > 1:
        nuevos_runs = []
        for i in range(0, len(runs), k):
            grupo = runs[i:i + k]
            mezclado = grupo[0]
            for r in grupo[1:]:
                mezclado = intercalar(mezclado, r)
            nuevos_runs.append(mezclado)
        runs = nuevos_runs
    return runs[0]


