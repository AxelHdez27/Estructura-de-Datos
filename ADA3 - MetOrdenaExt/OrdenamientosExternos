def ejecutar_metodo(nombre_metodo, k=None):
    """Flujo completo: seleccionar → leer → ordenar → guardar."""
    print(f"\n{'─'*57}")
    print(f"  MÉTODO: {nombre_metodo}")
    print(f"{'─'*57}")
    print("  Formatos soportados: .txt  |  .xlsx  |  .json\n")

    # ── Seleccionar archivos ──────────────────────────────────
    ruta1 = pedir_ruta(1)
    ruta2 = pedir_ruta(2)

    # ── Leer números ─────────────────────────────────────────
    try:
        nums1, tipo1 = leer_archivo(ruta1)
        nums2, tipo2 = leer_archivo(ruta2)
    except Exception as e:
        print(f"\n  [ERROR] {e}\n")
        return

    combinados = nums1 + nums2

    print(f"\n  [{tipo1}] {os.path.basename(ruta1)} → {nums1}")
    print(f"  [{tipo2}] {os.path.basename(ruta2)} → {nums2}")
    print(f"\n  Combinados ({len(combinados)} números): {combinados}")

    # ── Ordenar ───────────────────────────────────────────────
    if nombre_metodo == "Intercalacion":
        resultado = ordenar_intercalacion(combinados)
    elif nombre_metodo == "Mezcla Directa":
        resultado = ordenar_mezcla_directa(combinados)
    else:
        resultado = ordenar_mezcla_equilibrada(combinados, k)

    print(f"  Resultado ordenado: {resultado}")

    # ── Guardar ───────────────────────────────────────────────
    ruta_salida = pedir_ruta_salida()
    try:
        escribir_resultado(
            ruta_salida, resultado, nombre_metodo,
            os.path.basename(ruta1), os.path.basename(ruta2),
            tipo1, tipo2
        )
        print(f"\n  [OK] Archivo creado : {os.path.abspath(ruta_salida)}")
        print(f"  [OK] Total ordenados: {len(resultado)} números")
        if k:
            print(f"  [OK] Cintas usadas  : {k}")
    except Exception as e:
        print(f"\n  [ERROR] No se pudo guardar: {e}")


