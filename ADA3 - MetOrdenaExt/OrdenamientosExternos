def escribir_resultado(ruta, numeros, metodo, arch1, arch2, tipo1, tipo2):
    """Escribe los números ordenados en un archivo .txt con encabezado."""
    with open(ruta, "w", encoding="utf-8") as f:
        f.write("=" * 55 + "\n")
        f.write("  RESULTADO DE ORDENAMIENTO EXTERNO\n")
        f.write("=" * 55 + "\n")
        f.write(f"  Metodo        : {metodo}\n")
        f.write(f"  Archivo 1     : {arch1}  [{tipo1}]\n")
        f.write(f"  Archivo 2     : {arch2}  [{tipo2}]\n")
        f.write(f"  Total numeros : {len(numeros)}\n")
        f.write("=" * 55 + "\n\n")
        f.write("Numeros ordenados (uno por linea):\n")
        f.write("-" * 30 + "\n")
        for num in numeros:
            f.write(f"{num}\n")
        f.write("-" * 30 + "\n\n")
        f.write("Numeros en una sola linea:\n")
        f.write(", ".join(str(n) for n in numeros) + "\n")


