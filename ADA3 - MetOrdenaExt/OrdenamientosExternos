def limpiar_pantalla():
    os.system('cls' if os.name == 'nt' else 'clear')


def pedir_lista():
    """Solicita al usuario una lista de números separados por coma."""
    while True:
        entrada = input("  Ingresa los números separados por coma\n  > ").strip()
        if not entrada:
            print("  [!] No ingresaste nada. Intenta de nuevo.\n")
            continue
        try:
            numeros = [float(x.strip()) for x in entrada.split(",")]
            # Convierte a entero si todos son enteros
            if all(x == int(x) for x in numeros):
                numeros = [int(x) for x in numeros]
            return numeros
        except ValueError:
            print("  [!] Solo se permiten números. Ejemplo: 45, 12, 88, 3\n")


def mostrar_banner():
    print("=" * 55)
    print("   MÉTODOS DE ORDENAMIENTO EXTERNO EN PYTHON")
    print("=" * 55)
    print("   1. Intercalación")
    print("   2. Mezcla Directa")
    print("   3. Mezcla Equilibrada")
    print("   0. Salir")
    print("-" * 55)


def ejecutar_intercalacion():
    print("\n  ── INTERCALACIÓN ──")
    print("  Divide y fusiona mitades ordenadas de forma recursiva.\n")
    lista = pedir_lista()
    print(f"\n  Original : {lista}")
    resultado = ordenar_intercalacion(lista)
    print(f"  Ordenado : {resultado}")
    print(f"\n  Mínimo: {resultado[0]}  |  Máximo: {resultado[-1]}")


def ejecutar_mezcla_directa():
    print("\n  ── MEZCLA DIRECTA ──")
    print("  Mezcla runs de tamaño 1→2→4→8… de forma iterativa.\n")
    lista = pedir_lista()
    print(f"\n  Original : {lista}")
    ordenar_mezcla_directa(lista)
    print(f"  Ordenado : {lista}")
    print(f"\n  Mínimo: {lista[0]}  |  Máximo: {lista[-1]}")


def ejecutar_mezcla_equilibrada():
    print("\n  ── MEZCLA EQUILIBRADA ──")
    print("  Distribuye en cintas y mezcla de k en k runs.\n")
    lista = pedir_lista()
    while True:
        k_str = input("  ¿Cuántas cintas (k) deseas? [default=2]: ").strip()
        if k_str == "":
            k = 2; break
        try:
            k = int(k_str)
            if k >= 2: break
            print("  [!] k debe ser >= 2.")
        except ValueError:
            print("  [!] Ingresa un número entero.")
    print(f"\n  Original : {lista}")
    resultado = ordenar_mezcla_equilibrada(lista, k)
    print(f"  Ordenado : {resultado}")
    print(f"\n  Cintas usadas: {k}  |  Mínimo: {resultado[0]}  |  Máximo: {resultado[-1]}")


