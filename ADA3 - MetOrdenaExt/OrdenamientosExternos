def limpiar():
    os.system('cls' if os.name == 'nt' else 'clear')


def pedir_ruta(numero):
    """
    Permite elegir el archivo de dos formas:
      E → Explorador visual (abre ventana del sistema)
      M → Manual (escribe la ruta a mano)
    """
    while True:
        print(f"\n  Archivo {numero} — ¿Cómo quieres buscarlo?")
        print("    E = Abrir explorador de archivos")
        print("    M = Escribir la ruta manualmente")
        modo = input("  Elige (E/M): ").strip().upper()

        if modo == "E":
            if not TKINTER_DISPONIBLE:
                print("  [!] tkinter no disponible. Usa modo manual (M).")
                continue
            print("  [*] Abriendo explorador...")
            ruta = abrir_explorador(numero)
            if not ruta:
                print("  [!] No seleccionaste ningún archivo.")
                continue
            print(f"  [OK] Seleccionado: {ruta}")
            return ruta

        elif modo == "M":
            ruta = input(f"  Ruta del archivo {numero}: ").strip().strip('"').strip("'")
            if not ruta:
                print("  [!] No ingresaste ninguna ruta."); continue
            if not os.path.isfile(ruta):
                print(f"  [!] Archivo no encontrado:\n      {ruta}"); continue
            ext = os.path.splitext(ruta)[1].lower()
            if ext not in (".txt", ".xlsx", ".xls", ".json"):
                print("  [!] Formato no soportado. Usa .txt, .xlsx o .json"); continue
            return ruta
        else:
            print("  [!] Opción inválida. Escribe E o M.")


def pedir_ruta_salida():
    """Permite elegir dónde guardar el resultado (explorador o manual)."""
    while True:
        print("\n  Archivo de salida — ¿Cómo quieres guardarlo?")
        print("    E = Abrir explorador para guardar")
        print("    M = Escribir nombre manualmente")
        modo = input("  Elige (E/M): ").strip().upper()

        if modo == "E":
            if not TKINTER_DISPONIBLE:
                print("  [!] tkinter no disponible. Usa modo manual (M).")
                continue
            print("  [*] Abriendo explorador...")
            ruta = abrir_explorador_guardar()
            if not ruta:
                print("  [!] No elegiste ninguna ubicación.")
                continue
            print(f"  [OK] Se guardará en: {ruta}")
            return ruta

        elif modo == "M":
            ruta = input("  Nombre del archivo (ej: resultado.txt): ").strip().strip('"').strip("'")
            if not ruta:
                print("  [!] Debes ingresar un nombre."); continue
            if not ruta.lower().endswith(".txt"):
                ruta += ".txt"
            if os.path.isfile(ruta):
                resp = input(f"  '{ruta}' ya existe. ¿Sobreescribir? (s/n): ").strip().lower()
                if resp != "s":
                    continue
            return ruta
        else:
            print("  [!] Opción inválida. Escribe E o M.")


def pedir_k():
    while True:
        k_str = input("  Número de cintas k [default=2]: ").strip()
        if k_str == "":
            return 2
        try:
            k = int(k_str)
            if k >= 2: return k
            print("  [!] k debe ser >= 2.")
        except ValueError:
            print("  [!] Ingresa un número entero.")


