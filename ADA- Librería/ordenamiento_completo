def ejecutar_metodo_interno():
    """Ejecuta un método de ordenamiento interno (1 archivo)"""
    print("\n" + "=" * 70)
    print("  ORDENAMIENTO INTERNO - 1 ARCHIVO")
    print("=" * 70)
    
    # Mostrar métodos disponibles
    print("\n  Métodos disponibles:")
    metodos_lista = list(METODOS_INTERNOS.keys())
    for i, key in enumerate(metodos_lista, 1):
        print(f"    {i}. {NOMBRES_METODOS_INTERNOS[key]}")
    
    # Seleccionar método
    while True:
        try:
            opcion = int(input(f"\n  Selecciona método (1-{len(metodos_lista)}): "))
            if 1 <= opcion <= len(metodos_lista):
                metodo_key = metodos_lista[opcion - 1]
                metodo_nombre = NOMBRES_METODOS_INTERNOS[metodo_key]
                metodo_funcion = METODOS_INTERNOS[metodo_key]
                break
            print(f"  Opción inválida. Elige 1-{len(metodos_lista)}")
        except ValueError:
            print("  Ingresa un número válido")
    
    print(f"\n  Método seleccionado: {metodo_nombre}")
    
    # Seleccionar archivo
    archivo = seleccionar_archivo("Selecciona el archivo", obligatorio=True)
    if not archivo:
        print("  ❌ Debes seleccionar un archivo")
        return
    
    try:
        # Leer datos
        datos = leer_archivo(archivo)
        print(f"\n  📁 Archivo: {os.path.basename(archivo)}")
        print(f"  📊 Números ({len(datos)}): {datos}")
        
        # Ordenar
        print(f"\n  🔄 Ordenando con {metodo_nombre}...")
        resultado = metodo_funcion(datos)
        
        print(f"\n  ✅ Resultado ordenado ({len(resultado)} números):")
        print(f"     {resultado}")
        
        # Guardar resultado
        guardar_resultado(resultado, metodo_nombre, [archivo], "Interno")
        
    except Exception as e:
        print(f"\n  ❌ Error: {e}")


def ejecutar_metodo_externo():
    """Ejecuta un método de ordenamiento externo (2 archivos)"""
    print("\n" + "=" * 70)
    print("  ORDENAMIENTO EXTERNO - 2 ARCHIVOS")
    print("=" * 70)
    
    # Mostrar métodos disponibles
    print("\n  Métodos disponibles:")
    metodos_lista = list(METODOS_EXTERNOS.keys())
    for i, key in enumerate(metodos_lista, 1):
        print(f"    {i}. {NOMBRES_METODOS_EXTERNOS[key]}")
    
    # Seleccionar método
    while True:
        try:
            opcion = int(input(f"\n  Selecciona método (1-{len(metodos_lista)}): "))
            if 1 <= opcion <= len(metodos_lista):
                metodo_key = metodos_lista[opcion - 1]
                metodo_nombre = NOMBRES_METODOS_EXTERNOS[metodo_key]
                metodo_funcion = METODOS_EXTERNOS[metodo_key]
                break
            print(f"  Opción inválida. Elige 1-{len(metodos_lista)}")
        except ValueError:
            print("  Ingresa un número válido")
    
    print(f"\n  Método seleccionado: {metodo_nombre}")
    
    # Configuración adicional para mezcla equilibrada
    k = None
    if metodo_key == "mezcla_equilibrada":
        while True:
            try:
                k = int(input("  Número de cintas (k) [default=2]: ") or "2")
                if k >= 2:
                    break
                print("  k debe ser >= 2")
            except ValueError:
                print("  Ingresa un número entero")
        print(f"  Cintas utilizadas: {k}")
    
    # Seleccionar archivos
    archivo1 = seleccionar_archivo("Selecciona el PRIMER archivo", obligatorio=True)
    if not archivo1:
        print("  ❌ Debes seleccionar al menos un archivo")
        return
    
    archivo2 = seleccionar_archivo("Selecciona el SEGUNDO archivo", obligatorio=True)
    if not archivo2:
        print("  ❌ Debes seleccionar el segundo archivo")
        return
    
    try:
        # Leer datos
        datos1 = leer_archivo_externo(archivo1)
        datos2 = leer_archivo_externo(archivo2)
        
        print(f"\n  📁 Archivo 1: {os.path.basename(archivo1)}")
        print(f"     Números ({len(datos1)}): {datos1}")
        print(f"\n  📁 Archivo 2: {os.path.basename(archivo2)}")
        print(f"     Números ({len(datos2)}): {datos2}")
        
        # Combinar datos
        combinados = datos1 + datos2
        print(f"\n  📊 Datos combinados ({len(combinados)} números): {combinados}")
        
        # Ordenar
        print(f"\n  🔄 Ordenando con {metodo_nombre}...")
        if k:
            resultado = metodo_funcion(combinados, k)
        else:
            resultado = metodo_funcion(combinados)
        
        print(f"\n  ✅ Resultado ordenado ({len(resultado)} números):")
        print(f"     {resultado}")
        
        # Guardar resultado
        guardar_resultado(resultado, metodo_nombre.split()[0], [archivo1, archivo2], "Externo")
        
    except Exception as e:
        print(f"\n  ❌ Error: {e}")


def crear_archivos_ejemplo():
    """Crea archivos de ejemplo para probar"""
    print("\n  📁 Creando archivos de ejemplo...")
    
    # Archivos TXT
    with open("datos1.txt", "w", encoding="utf-8") as f:
        f.write("85, 72, 91, 60, 78, 34, 55, 19")
    
    with open("datos2.txt", "w", encoding="utf-8") as f:
        f.write("43, 67, 11, 98, 25, 50, 73, 88")
    
    with open("datos3.txt", "w", encoding="utf-8") as f:
        f.write("5, 2, 9, 1, 7, 3, 8, 4, 6")
    
    # Archivos JSON
    with open("datos1.json", "w", encoding="utf-8") as f:
        json.dump([85, 72, 91, 60, 78, 34, 55, 19], f)
    
    with open("datos2.json", "w", encoding="utf-8") as f:
        json.dump({"numeros": [43, 67, 11, 98, 25, 50, 73, 88]}, f)
    
    # Archivos Excel
    if EXCEL_DISPONIBLE:
        import openpyxl
        
        wb = openpyxl.Workbook()
        ws = wb.active
        ws.title = "Numeros"
        for v in [85, 72, 91, 60, 78, 34, 55, 19]:
            ws.append([v])
        wb.save("datos1.xlsx")
        
        wb2 = openpyxl.Workbook()
        ws2 = wb2.active
        ws2.title = "Valores"
        for v in [43, 67, 11, 98, 25, 50, 73, 88]:
            ws2.append([v])
        wb2.save("datos2.xlsx")
    
    print("\n  ✅ Archivos creados:")
    print("     📄 TXT: datos1.txt, datos2.txt, datos3.txt")
    print("     📄 JSON: datos1.json, datos2.json")
    if EXCEL_DISPONIBLE:
        print("     📊 Excel: datos1.xlsx, datos2.xlsx")
    print(f"\n  📁 Carpeta: {os.getcwd()}")


